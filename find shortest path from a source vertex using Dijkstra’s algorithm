#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

// Dijkstra Function
vector<int> dijkstra(vector<vector<pair<int,int>>> &adj, int src) {

    int V = adj.size();

    // Min-heap (distance, node)
    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;

    vector<int> dist(V, INT_MAX);

    // Source distance = 0
    dist[src] = 0;
    pq.push({0, src});

    while (!pq.empty()) {
        auto top = pq.top();
        pq.pop();

        int d = top.first;
        int u = top.second;

        // Skip if outdated
        if (d > dist[u])
            continue;

        // Explore neighbors
        for (auto &p : adj[u]) {
            int v = p.first;
            int w = p.second;

            // Relaxation
            if (dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                pq.push({dist[v], v});
            }
        }
    }

    return dist;
}

// Driver Code
int main() {
    int src = 0;

    vector<vector<pair<int,int>>> adj(5);

    adj[0] = {{1,4}, {2,8}};
    adj[1] = {{0,4}, {4,6}, {2,3}};
    adj[2] = {{0,8}, {3,2}, {1,3}};
    adj[3] = {{2,2}, {4,10}};
    adj[4] = {{1,6}, {3,10}};

    vector<int> result = dijkstra(adj, src);

    cout << "Shortest distances from source:\n";
    for (int d : result)
        cout << d << " ";

    cout << endl;

    return 0;
}
