#include <iostream>
#include <vector>
#include <queue>
using namespace std;

// Function to construct adjacency list
vector<vector<int>> constructAdj(int V, vector<pair<int,int>> edges) {
    vector<vector<int>> adj(V);

    for (auto edge : edges) {
        int u = edge.first;
        int v = edge.second;

        adj[u].push_back(v);
        adj[v].push_back(u); // undirected graph
    }

    return adj;
}

// Function to check bipartite
bool isBipartite(int V, vector<pair<int,int>> edges) {
    vector<int> color(V, -1); // -1 means uncolored
    vector<vector<int>> adj = constructAdj(V, edges);

    for (int i = 0; i < V; i++) {
        if (color[i] == -1) {
            queue<int> q;
            q.push(i);
            color[i] = 0;

            while (!q.empty()) {
                int u = q.front();
                q.pop();

                for (int v : adj[u]) {
                    if (color[v] == -1) {
                        color[v] = 1 - color[u];
                        q.push(v);
                    }
                    else if (color[v] == color[u]) {
                        return false; // not bipartite
                    }
                }
            }
        }
    }

    return true;
}

// Driver Code
int main() {
    int V = 4;
    vector<pair<int,int>> edges = {
        {0,1}, {0,2}, {1,2}, {2,3}
    };

    if (isBipartite(V, edges))
        cout << "Graph is Bipartite";
    else
        cout << "Graph is Not Bipartite";

    return 0;
}
